$('btnExportResults').onclick = ()=>{
  if(!RESULTS.length) return err('Chưa có dữ liệu để xuất.');
  const head = ['Hoc vien','Email','Chu de','Luot','Nop luc','Thoi gian (giay)','Diem','Tong diem','Phan tram','Ket qua'];
  const rows = RESULTS.map(x=>[x.name,x.email,x.topic,x.attempt,x.submittedAt,x.durationSec,x.score,x.maxScore,x.percent,x.result]);
