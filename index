      <div class="fgroup"><label>Hình thức</label><select class="inp" id="f_type">
        ${(meta.types||['Internal','External']).map(c=>`<option ${s&&s.type.trim()===c.trim()?'selected':''}>${esc(c)}</option>`).join('')}</select></div>
      <div class="fgroup"><label>Trạng thái</label><select class="inp" id="f_status">
        ${['Plan','Completed','Cancel'].map(c=>`<option ${s&&s.status===c?'selected':''}>${c}</option>`).join('')}</select></div>
    </div>
    <div class="row2">
      <div class="fgroup"><label>Trainer *</label><select class="inp" id="f_trainer">
        ${(meta.trainers||[]).map(t=>`<option ${s?(s.trainer.trim()===t.trim()?'selected':''):(t===S.user.name?'selected':'')}>${esc(t)}</option>`).join('')}</select></div>
      <div class="fgroup"><label>Đối tượng tham dự *</label><select class="inp" id="f_aud">
        ${audienceOpts.map(a=>`<option ${s&&s.audience.trim()===a.trim()?'selected':''}>${esc(a)}</option>`).join('')}</select>
        <div class="hint">Hệ thống tự tạo danh sách học viên từ nhóm được chọn.</div></div>
    </div>
    <div class="row2">
      <div class="fgroup"><label>Link họp (Teams/Meet)</label><input class="inp" id="f_meet" value="${esc(s?s.meetingLink:'')}" placeholder="https://…"></div>
      <div class="fgroup"><label>Link bản ghi</label><input class="inp" id="f_rec" value="${esc(s?s.recordLink:'')}" placeholder="https://…"></div>
    </div>
    <div class="fgroup"><label>Tổng kết &amp; phản hồi</label><textarea class="inp" id="f_sum" placeholder="Ghi chú sau buổi đào tạo">${esc(s?s.summary:'')}</textarea></div>
    ${!s?`<label style="display:flex;align-items:center;gap:9px;font-size:13.5px;cursor:pointer;background:var(--pale);padding:12px 14px;border-radius:11px">
      <input type="checkbox" id="f_folder" checked style="width:17px;height:17px;accent-color:var(--navy)">
      <span>Tự động tạo thư mục tài liệu trên Drive theo nhóm chủ đề</span></label>`:''}`;
  $('ovSession').classList.add('on');
}
$('btnSaveSession').onclick = async ()=>{
  const p = {
    sid: S.editing||'', topic:$('f_topic').value.trim(), purpose:$('f_purpose').value.trim(),
    date:$('f_date').value, timeFrom:$('f_from').value, timeTo:$('f_to').value,
    category:$('f_cat').value, type:$('f_type').value, status:$('f_status').value,
    trainer:$('f_trainer').value, audience:$('f_aud').value,
    meetingLink:$('f_meet').value.trim(), recordLink:$('f_rec').value.trim(), summary:$('f_sum').value.trim(),
