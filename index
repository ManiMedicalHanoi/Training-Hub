  if(S.token){
    try{
      const r = await jsonp({action:'me', token:S.token});
      if(r && r.ok){
        S.user = r.user;
        $('loginWrap').style.display='none';
        $('app').classList.add('on');
        return boot();
      }
    }catch(e){}
    localStorage.removeItem('mmh_hub_token'); S.token='';
  }
  $('lgEmail').focus();
})();
</script>
</body>
</html>
