function drawChips(){
  $('em_to').innerHTML = EM.recipients.length
    ? EM.recipients.map((e,i)=>`<span class="chip">${esc(e)}<b onclick="EM.recipients.splice(${i},1);drawChips()">×</b></span>`).join('')
