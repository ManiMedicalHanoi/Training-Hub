<script>
/* ==========================================================================
   MMH TRAINING HUB — FRONTEND
   ---------------------------------------------------------------------------
   ★ VIỆC DUY NHẤT CẦN LÀM TRƯỚC KHI DÙNG:
     Thay chuỗi bên dưới bằng URL Web App của Code.gs (Training Hub).
     Lấy URL đó ở: Apps Script → Deploy → New deployment → Web app → Copy.
     URL có dạng:  https://script.google.com/macros/s/AKfycb.........../exec

   Lưu ý: đây là URL của dự án MỚI "MMH Training Hub Backend", KHÔNG phải
   URL web app cũ của file Google Sheet.
   ========================================================================== */

const API_URL = "https://script.google.com/macros/s/AKfycbwsX4cQEoH4LNlmcNfe8qWIM9K6EiDEXy7PjhP9bHY2citL6xHn5L1unsAlQJHyL9EP/exec";

/* ---------- STATE ---------- */
const S = {
  token: localStorage.getItem('mmh_hub_token') || '',
  user: null, config: {}, meta: {}, sessions: [], users: [], groups: [],
  stats: null, links: {}, quizFileUrl: '',
  view: 'dash', calDate: new Date(),
  filters: {q:'', cat:'', status:'', trainer:'', quick:'all'},
  editing: null, qbQuestions: [], qbSid: '', attempt: null, timerId: null,
  charts: {}
};

/* ---------- API ---------- */
let _seq = 0;
function jsonp(params){
  return new Promise((resolve,reject)=>{
    const cb = '__hub_cb_' + (_seq++);
    const s = document.createElement('script');
    const to = setTimeout(()=>{cleanup();reject(new Error('Hết thời gian chờ — kiểm tra quyền truy cập Web App'))}, 45000);
    function cleanup(){clearTimeout(to);try{delete window[cb]}catch(e){window[cb]=undefined};s.remove()}
    window[cb] = d => {cleanup();resolve(d)};
    const qs = Object.entries(params).map(([k,v])=>k+'='+encodeURIComponent(v==null?'':v)).join('&');
    s.src = API_URL + '?' + qs + '&callback=' + cb;
    s.onerror = ()=>{cleanup();reject(new Error('Không gọi được Web App'))};
    document.body.appendChild(s);
  });
}
async function apiGet(action, params){
  const p = Object.assign({action:action, token:S.token}, params||{});
  const r = await jsonp(p);
  if(r && r.code === 'AUTH'){ doLogout(true); throw new Error(r.error); }
  if(!r || !r.ok) throw new Error((r && r.error) || 'Phản hồi không hợp lệ');
  return r;
}
async function apiPost(action, payload){
  const body = new URLSearchParams();
  body.set('action', action);
  body.set('token', S.token);
  body.set('payload', JSON.stringify(Object.assign({action:action, token:S.token}, payload||{})));
  const res = await fetch(API_URL, {method:'POST', body:body});
  const r = await res.json();
  if(r && r.code === 'AUTH'){ doLogout(true); throw new Error(r.error); }
  if(!r || !r.ok) throw new Error((r && r.error) || 'Thao tác thất bại');
  return r;
}

/* ---------- HELPERS ---------- */
const $ = id => document.getElementById(id);
const esc = s => String(s==null?'':s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
const nnum = n => (n==null||n==='') ? 0 : Number(n);
function toast(msg, type){
  const d = document.createElement('div');
  d.className = 'toast ' + (type||'');
  d.innerHTML = '<span>'+esc(msg)+'</span>';
  $('toasts').appendChild(d);
  setTimeout(()=>{d.style.opacity='0';d.style.transform='translateX(30px)';d.style.transition='.3s';setTimeout(()=>d.remove(),320)}, 4200);
}
const ok  = m => toast(m,'ok');
const err = m => toast(m,'err');
function busy(on, txt){ $('loadTxt').textContent = txt||'Đang xử lý…'; $('loader').classList.toggle('on', !!on); }
function catClass(c){
  const k = (c||'').toLowerCase();
  if(k.indexOf('product')>=0) return 'product';
  if(k.indexOf('sop')>=0) return 'sop';
  if(k.indexOf('compli')>=0) return 'compliance';
  if(k.indexOf('skil')>=0) return 'skill';
  return 'audience';
}
function statusClass(s){
  const k = (s||'').toLowerCase();
  if(k.indexOf('complet')>=0) return 'completed';
  if(k.indexOf('cancel')>=0) return 'cancel';
  return 'plan';
}
function statusText(s){
  const k = (s||'').toLowerCase();
  if(k.indexOf('complet')>=0) return 'Hoàn thành';
  if(k.indexOf('cancel')>=0) return 'Đã huỷ';
  return 'Kế hoạch';
}
function initials(n){
  const p = String(n||'?').trim().split(/\s+/);
  return (p.length>1 ? p[0][0]+p[p.length-1][0] : String(n||'?').substring(0,2)).toUpperCase();
}
function fmtSec(s){
  s = Math.max(0, Math.floor(s));
  const m = Math.floor(s/60), r = s%60;
  return (m<10?'0':'')+m+':'+(r<10?'0':'')+r;
}
function dmy(iso){
  if(!iso) return '';
  const p = String(iso).split('-');
  return p.length===3 ? p[2]+'/'+p[1]+'/'+p[0] : iso;
}
function setConn(state, text){
  $('connDot').className = 'dot ' + (state||'');
  $('connText').textContent = text;
}
function closeOv(el){ el.classList.remove('on'); }
document.addEventListener('click', e=>{
  if(e.target.hasAttribute && e.target.hasAttribute('data-close')) { closeAll(); }
  if(e.target.classList && e.target.classList.contains('ov')) closeAll();
});
function closeAll(){
  document.querySelectorAll('.ov.on').forEach(o=>{
    if(o.id === 'ovQuiz' && S.attempt) return;  // không cho thoát khi đang làm bài
    o.classList.remove('on');
  });
  if($('vwFrame')) $('vwFrame').src = 'about:blank';
}

/* ==========================================================================
   AUTH
   ========================================================================== */
function showLoginMsg(text, type){
  const m = $('loginMsg');
  m.className = 'msg ' + (type||'info');
  m.innerHTML = text;
}
$('goOtp').onclick = ()=>{
  $('stepLogin').style.display='none'; $('stepOtp').style.display='';
  $('otEmail').value = $('lgEmail').value; showLoginMsg('','');
  $('loginMsg').className='msg';
};
$('goLogin').onclick = ()=>{
  $('stepOtp').style.display='none'; $('stepLogin').style.display='';
  $('loginMsg').className='msg';
};
$('btnLogin').onclick = async ()=>{
  const email = $('lgEmail').value.trim(), pin = $('lgPin').value;
  if(!email || !pin) return showLoginMsg('Vui lòng nhập email và PIN.','err');
  $('btnLogin').disabled = true; showLoginMsg('Đang đăng nhập…','info');
  try{
    const r = await jsonp({action:'login', email:email, pin:pin});
    if(!r.ok){
      showLoginMsg(esc(r.error), 'err');
      if(r.code === 'NEED_OTP'){ $('goOtp').click(); $('otEmail').value = email; }
      return;
    }
    onLoggedIn(r);
  }catch(e){ showLoginMsg('Lỗi kết nối: '+esc(e.message), 'err'); }
  finally{ $('btnLogin').disabled = false; }
};
$('btnSendOtp').onclick = async ()=>{
  const email = $('otEmail').value.trim();
  if(!email) return showLoginMsg('Vui lòng nhập email công ty.','err');
  $('btnSendOtp').disabled = true; showLoginMsg('Đang gửi mã…','info');
  try{
    const r = await jsonp({action:'requestOtp', email:email});
    if(!r.ok) return showLoginMsg(esc(r.error),'err');
    showLoginMsg('✓ ' + esc(r.message) + '. Mã có hiệu lực 10 phút.','ok');
    $('otpFields').style.display=''; $('otCode').focus();
  }catch(e){ showLoginMsg('Lỗi kết nối: '+esc(e.message),'err'); }
  finally{ $('btnSendOtp').disabled = false; }
};
$('btnVerify').onclick = async ()=>{
  const email = $('otEmail').value.trim(), code = $('otCode').value.trim(), pin = $('otPin').value;
  if(!code || !pin) return showLoginMsg('Nhập mã kích hoạt và PIN mới.','err');
  $('btnVerify').disabled = true; showLoginMsg('Đang xác thực…','info');
  try{
    const r = await jsonp({action:'verifyOtp', email:email, code:code, pin:pin});
    if(!r.ok) return showLoginMsg(esc(r.error),'err');
    onLoggedIn(r);
  }catch(e){ showLoginMsg('Lỗi kết nối: '+esc(e.message),'err'); }
  finally{ $('btnVerify').disabled = false; }
};
['lgPin','lgEmail'].forEach(id=>$(id).addEventListener('keydown',e=>{if(e.key==='Enter')$('btnLogin').click()}));
$('otPin').addEventListener('keydown',e=>{if(e.key==='Enter')$('btnVerify').click()});

function onLoggedIn(r){
  S.token = r.token; S.user = r.user;
  localStorage.setItem('mmh_hub_token', r.token);
  $('loginWrap').style.display='none';
  $('app').classList.add('on');
  boot();
}
function doLogout(silent){
  if(!silent) apiGet('logout').catch(()=>{});
  localStorage.removeItem('mmh_hub_token');
  S.token=''; S.user=null;
  $('app').classList.remove('on');
  $('loginWrap').style.display='';
  $('stepOtp').style.display='none'; $('stepLogin').style.display='';
  $('loginMsg').className='msg'; $('lgPin').value='';
  if(silent) showLoginMsg('Phiên đăng nhập đã hết hạn, vui lòng đăng nhập lại.','err');
}
$('btnLogout').onclick = ()=>{ if(confirm('Đăng xuất khỏi Training Hub?')) doLogout(); };

/* ==========================================================================
   BOOT
   ========================================================================== */
async function boot(){
  setConn('load','Đang tải dữ liệu…');
  busy(true,'Đang tải dữ liệu đào tạo…');
  try{
    const r = await apiGet('bootstrap');
    S.user = r.user; S.config = r.config||{}; S.meta = r.meta||{};
    S.sessions = r.sessions||[]; S.users = r.users||[]; S.groups = r.groups||[];
    S.stats = r.stats||null; S.quizFileUrl = r.quizFileUrl||'';
    S.links = r.driveFolders||{};
    applyBrand();
    renderShell();
    renderAll();
    setConn('','Đã kết nối · ' + new Date().toLocaleTimeString('vi-VN'));
  }catch(e){
    setConn('off','Mất kết nối');
    err('Không tải được dữ liệu: ' + e.message);
  }finally{ busy(false); }
}
$('btnRefresh').onclick = ()=>boot();

function applyBrand(){
  const c = S.config;
  if(c.COLOR_PRIMARY)   document.documentElement.style.setProperty('--navy', c.COLOR_PRIMARY);
  if(c.COLOR_ACCENT)    document.documentElement.style.setProperty('--blue', c.COLOR_ACCENT);
  if(c.COLOR_HIGHLIGHT) document.documentElement.style.setProperty('--yellow', c.COLOR_HIGHLIGHT);
  if(c.APP_TITLE){ document.title = c.APP_TITLE + ' — Mani Medical Hanoi'; $('sbTitle').textContent = c.APP_TITLE.replace(/^MMH\s*/,''); }
  if(c.FISCAL_YEAR) $('sbFY').textContent = 'MMH · ' + c.FISCAL_YEAR;
  document.querySelectorAll('.mark').forEach(m=>{ if(c.LOGO_TEXT) m.textContent = c.LOGO_TEXT; });
}

function renderShell(){
  const u = S.user;
  $('uAvatar').textContent = initials(u.name);
  $('uName').textContent = u.name;
  $('uRole').textContent = (u.role==='admin'?'Admin':u.role==='trainer'?'Trainer':'Học viên') + (u.position? ' · '+u.position : '');
  $('navTrainer').style.display = u.isTrainer ? '' : 'none';
  $('navAdmin').style.display   = u.isAdmin ? '' : 'none';
  $('btnNewSession').style.display = u.isTrainer ? '' : 'none';
  $('lnkParent').href   = S.links.parent || '#';
  $('lnkCert').href     = S.links.certificate || '#';
  $('lnkQuizFile').href = S.quizFileUrl || '#';
}

/* ---------- NAV ---------- */
const PAGE_META = {
  dash:['Dashboard','Tổng quan hoạt động đào tạo'],
  cal:['Lịch đào tạo','Xem lịch theo tháng'],
  sessions:['Bài đào tạo','Toàn bộ chương trình đào tạo MMH'],
  mytraining:['Đào tạo của tôi','Bài được phân công & kết quả'],
  certs:['Chứng chỉ','Chứng chỉ bạn đã đạt được'],
  manage:['Quản lý đào tạo','Tạo buổi, tải tài liệu, ra đề, gửi email'],
  results:['Kết quả đánh giá','Điểm số & tỷ lệ đạt của học viên'],
  users:['Người dùng','Phân quyền & quản lý tài khoản'],
  settings:['Cấu hình','Tuỳ chỉnh giao diện & quy tắc']
};
document.querySelectorAll('.nv').forEach(n=>{
  n.onclick = ()=>go(n.dataset.v);
});
function go(v){
  S.view = v;
  document.querySelectorAll('.nv').forEach(n=>n.classList.toggle('on', n.dataset.v===v));
  document.querySelectorAll('.view').forEach(s=>s.classList.toggle('on', s.id==='v-'+v));
  const m = PAGE_META[v]||['',''];
  $('pgTitle').textContent = m[0]; $('pgSub').textContent = m[1];
  $('sidebar').classList.remove('open');
  if(v==='cal') renderCalendar();
  if(v==='results') renderResults();
  if(v==='users') renderUsers();
  if(v==='settings') renderSettings();
  window.scrollTo(0,0);
}
$('burger').onclick = ()=>$('sidebar').classList.toggle('open');

/** Chạy từng khối render độc lập — một khối lỗi không làm hỏng cả trang */
function safeRun(name, fn){
  try{ fn(); }
  catch(e){ console.error('[render '+name+']', e); }
}
function renderAll(){
  safeRun('dashboard', renderDashboard);
  safeRun('sessions',  renderSessions);
  safeRun('mytraining',renderMyTraining);
  safeRun('certs',     renderCerts);
  safeRun('manage',    renderManage);
  safeRun('filters',   fillFilters);
  const todo = S.sessions.filter(s=>s.hasQuiz && s.quizActive && s.myStatus!=='Completed' && isMine(s)).length;
  $('bdgTodo').textContent = todo>0 ? todo : '';
  $('bdgTodo').style.display = todo>0 ? '' : 'none';
  $('bdgSessions').textContent = S.sessions.filter(s=>s.status!=='Cancel').length;
}
function isMine(s){
  const e = (S.user.email||'').split('@')[0].toLowerCase();
  return (s.audienceEmails||[]).some(x=>String(x).split('@')[0].toLowerCase()===e) || s.myStatus || s.myScore!=='';
}

/* ==========================================================================
   DASHBOARD
   ========================================================================== */
function renderDashboard(){
  const k = (S.stats && S.stats.kpi) || {};
  $('kpiRow').innerHTML = [
    kpiCard('navy','Tổng buổi đào tạo', k.totalSessions||0, (k.completedSessions||0)+' hoàn thành · '+(k.plannedSessions||0)+' kế hoạch'),
    kpiCard('green','Tỷ lệ đạt', (k.passRate||0)+'%', (k.totalPass||0)+'/'+(k.totalDone||0)+' lượt đánh giá'),
    kpiCard('gold','Điểm trung bình', (k.avgScore||0)+'%', 'Trên toàn bộ bài đánh giá'),
    kpiCard('orange','Chứng chỉ đã cấp', k.totalCerts||0, (k.totalLearners||0)+' nhân sự tham gia')
  ].join('');

  const st = S.stats||{};
  drawBar('chMonth', (st.byMonth||[]).map(m=>monthLabel(m.name)),
    [{label:'Tổng buổi', data:(st.byMonth||[]).map(m=>m.total), color:'#CFE2F3'},
     {label:'Hoàn thành', data:(st.byMonth||[]).map(m=>m.done), color:'#3A5CAA'}]);

  drawDoughnut('chCat', (st.byCategory||[]).map(c=>c.name), (st.byCategory||[]).map(c=>c.total));

  const tr = (st.byTrainer||[]).slice(0,8);
  drawBarH('chTrainer', tr.map(t=>t.name), tr.map(t=>t.total), tr.map(t=>t.done));

  const passed = k.totalPass||0, failed = Math.max(0,(k.totalDone||0)-passed), pending = Math.max(0,(k.totalEnroll||0)-(k.totalDone||0));
  drawDoughnut('chPass', ['Đạt','Chưa đạt','Chưa làm bài'], [passed,failed,pending], ['#2f9e5e','#d64545','#CFE2F3']);

  const up = st.upcoming||[];
  $('upcomingBox').innerHTML = up.length ? up.map(s=>`
    <div class="file-row" style="cursor:pointer" onclick="openDetail('${s.sid}')">
      <div class="file-ic" style="background:var(--navy);flex-direction:column;line-height:1;gap:1px">
        <span style="font-size:14px">${esc((s.dateText||'').split('/')[0]||'')}</span>
        <span style="font-size:8px;opacity:.8">TH${esc((s.dateText||'').split('/')[1]||'')}</span>
      </div>
      <div class="nm"><b>${esc(s.topic)}</b><span>${esc(s.trainer)} · ${esc(s.audience)}</span></div>
      <span class="tag ${catClass(s.category)}">${esc(s.category)}</span>
    </div>`).join('') : emptyBox('Chưa có buổi đào tạo nào sắp tới');

  const lead = (st.learners||[]).filter(l=>l.assigned>0).slice(0,25);
  $('leaderBox').innerHTML = lead.length ? `<table class="tbl">
    <thead><tr><th>#</th><th>Học viên</th><th>Được giao</th><th>Hoàn thành</th><th>Đạt</th><th>Điểm TB</th></tr></thead>
    <tbody>${lead.map((l,i)=>`<tr>
      <td><b style="color:var(--muted)">${i+1}</b></td>
      <td><div style="display:flex;align-items:center;gap:9px"><div class="avatar" style="width:28px;height:28px;font-size:11px">${initials(l.name)}</div><div><b style="font-size:13px;color:var(--navy)">${esc(l.name)}</b><div style="font-size:11px;color:var(--muted)">${esc(l.dept||'')}</div></div></div></td>
      <td>${l.assigned}</td><td>${l.completed}</td>
      <td><span class="tag ${l.passed>0?'pass':'audience'}">${l.passed}</span></td>
      <td><b style="color:var(--navy)">${l.avg}%</b></td>
    </tr>`).join('')}</tbody></table>` : emptyBox('Chưa có dữ liệu học viên');
}
function kpiCard(cls,label,val,sub){
  return `<div class="kpi ${cls}"><div class="lb">${esc(label)}</div><div class="vl">${esc(val)}</div><div class="sub">${esc(sub)}</div></div>`;
}
function emptyBox(t,sub){
  return `<div class="empty"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M9 9h6M9 13h6M9 17h3"/></svg><b>${esc(t)}</b>${sub?'<div>'+esc(sub)+'</div>':''}</div>`;
}
function monthLabel(ym){
  if(!ym) return '';
  const p = String(ym).split('-');
  return p.length===2 ? 'T'+Number(p[1])+'/'+p[0].substring(2) : ym;
}
const CHART_FONT = {family:"Aptos, Inter, Segoe UI, sans-serif", size:11};
function destroyChart(id){ if(S.charts[id]){ try{S.charts[id].destroy()}catch(e){} delete S.charts[id]; } }
/** Thư viện biểu đồ nạp từ CDN — nếu mạng công ty chặn thì hiện thông báo
 *  thay vì làm hỏng toàn bộ trang. */
function chartReady(id){
  if(typeof Chart !== 'undefined') return true;
  const el = $(id);
  if(el && el.parentNode) el.parentNode.innerHTML =
    '<div class="empty" style="padding:30px 16px"><b>Không tải được thư viện biểu đồ</b>'+
    '<div style="font-size:12.5px">Số liệu vẫn đầy đủ ở các thẻ phía trên và trong bảng. '+
    'Nếu mạng công ty chặn cdnjs.cloudflare.com, hãy báo IT mở hoặc dùng bản Chart.js nội bộ.</div></div>';
  return false;
}
function drawBar(id, labels, series){
  if(!chartReady(id)) return;
  destroyChart(id); const el = $(id); if(!el) return;
  S.charts[id] = new Chart(el, {type:'bar', data:{labels:labels, datasets:series.map(s=>({label:s.label,data:s.data,backgroundColor:s.color,borderRadius:5,maxBarThickness:34}))},
    options:{responsive:true,maintainAspectRatio:false,
      plugins:{legend:{position:'bottom',labels:{font:CHART_FONT,boxWidth:11,boxHeight:11,padding:14}}},
      scales:{x:{grid:{display:false},ticks:{font:CHART_FONT,color:'#7387a0'}},
              y:{beginAtZero:true,grid:{color:'#eef3fa'},ticks:{font:CHART_FONT,color:'#7387a0',precision:0}}}}});
}
function drawBarH(id, labels, total, done){
  if(!chartReady(id)) return;
  destroyChart(id); const el = $(id); if(!el) return;
  S.charts[id] = new Chart(el, {type:'bar',
    data:{labels:labels, datasets:[
      {label:'Tổng buổi',data:total,backgroundColor:'#CFE2F3',borderRadius:5},
      {label:'Hoàn thành',data:done,backgroundColor:'#003047',borderRadius:5}]},
    options:{indexAxis:'y',responsive:true,maintainAspectRatio:false,
      plugins:{legend:{position:'bottom',labels:{font:CHART_FONT,boxWidth:11,boxHeight:11,padding:14}}},
      scales:{x:{beginAtZero:true,grid:{color:'#eef3fa'},ticks:{font:CHART_FONT,color:'#7387a0',precision:0}},
              y:{grid:{display:false},ticks:{font:CHART_FONT,color:'#003047'}}}}});
}
function drawDoughnut(id, labels, data, colors){
  if(!chartReady(id)) return;
  destroyChart(id); const el = $(id); if(!el) return;
  const pal = colors || ['#003047','#3A5CAA','#FFE100','#CFE2F3','#2f9e5e','#e07b39','#7c3aed'];
  S.charts[id] = new Chart(el, {type:'doughnut', data:{labels:labels, datasets:[{data:data,backgroundColor:pal,borderWidth:2,borderColor:'#fff'}]},
    options:{responsive:true,maintainAspectRatio:false,cutout:'62%',
      plugins:{legend:{position:'bottom',labels:{font:CHART_FONT,boxWidth:11,boxHeight:11,padding:13}}}}});
}

