        </div>
        <button class="btn btn-primary btn-block" id="btnLogin">Đăng nhập</button>
        <div class="login-alt">Chưa có PIN hoặc quên PIN? <b id="goOtp">Gửi mã kích hoạt</b></div>
      </div>

      <!-- Step 2: OTP -->
      <div id="stepOtp" style="display:none">
        <div class="fgroup">
          <label>Email công ty</label>
          <input class="inp" id="otEmail" type="email" placeholder="ten.ban@mani.inc">
        </div>
        <button class="btn btn-ghost btn-block" id="btnSendOtp" style="margin-bottom:16px">Gửi mã kích hoạt qua email</button>
        <div id="otpFields" style="display:none">
          <div class="fgroup">
            <label>Mã kích hoạt (6 số)</label>
            <input class="inp otp-inp" id="otCode" maxlength="6" inputmode="numeric" placeholder="······">
          </div>
          <div class="fgroup">
            <label>Đặt mã PIN mới (tối thiểu 6 ký tự)</label>
            <input class="inp" id="otPin" type="password" placeholder="PIN mới">
