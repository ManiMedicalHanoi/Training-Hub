      <div class="msg" id="loginMsg"></div>

      <!-- Step 1: email + PIN -->
      <div id="stepLogin">
        <div class="fgroup">
          <label>Email công ty</label>
          <input class="inp" id="lgEmail" type="email" placeholder="ten.ban@mani.inc" autocomplete="username">
        </div>
        <div class="fgroup">
          <label>Mã PIN</label>
