        <button class="btn btn-ghost btn-sm" onclick="addCc('tt.tuyen@mani.inc')">+ HOD S&amp;M</button>
        <button class="btn btn-ghost btn-sm" onclick="addCc('nt.ha@mani.inc')">+ Director</button>
        <button class="btn btn-ghost btn-sm" onclick="addCc('mmh.product@mani.inc')">+ Product Team</button>
      </div></div>
    <div class="fgroup"><label>Ghi chú thêm (hiển thị trong email)</label>
