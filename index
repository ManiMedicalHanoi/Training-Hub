<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<meta name="theme-color" content="#003047">
<title>MMH Training Hub — Mani Medical Hanoi</title>
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
<style>
:root{
  --navy:#003047; --blue:#3A5CAA; --yellow:#FFE100; --lb:#CFE2F3; --pale:#F0F7FF;
  --ink:#1A1A1A; --muted:#7387a0; --line:#e6edf6; --white:#fff; --bg:#f4f8fd;
  --green:#2f9e5e; --red:#d64545; --orange:#e07b39; --cream:#FFF8E1;
  --shadow-sm:0 1px 3px rgba(7,30,60,.05),0 6px 18px rgba(7,30,60,.06);
  --shadow-md:0 4px 14px rgba(7,30,60,.08),0 18px 50px rgba(7,30,60,.13);
  --shadow-xl:0 10px 40px rgba(7,30,60,.16),0 40px 90px rgba(7,30,60,.22);
  --ease:cubic-bezier(.22,.61,.36,1);
  --sbw:248px;
}
*{margin:0;padding:0;box-sizing:border-box}
html{-webkit-text-size-adjust:100%}
body{font-family:'Aptos','Inter','Lexend','Segoe UI',system-ui,-apple-system,sans-serif;background:var(--bg);color:var(--ink);font-size:14.5px;line-height:1.6;-webkit-font-smoothing:antialiased}
a{color:inherit;text-decoration:none}
img{max-width:100%;display:block}
button,input,select,textarea{font-family:inherit;font-size:inherit}
::selection{background:var(--yellow);color:var(--navy)}
::-webkit-scrollbar{width:10px;height:10px}
::-webkit-scrollbar-thumb{background:#c8d6e8;border-radius:8px;border:3px solid var(--bg)}
::-webkit-scrollbar-thumb:hover{background:#a8bcd4}

/* ============ LOGIN ============ */
.login-wrap{position:fixed;inset:0;z-index:500;display:flex;align-items:center;justify-content:center;padding:22px;
  background:radial-gradient(1100px 560px at 50% -12%,rgba(58,92,170,.22),transparent 60%),
             radial-gradient(800px 460px at 85% 20%,rgba(255,225,0,.13),transparent 55%),
             linear-gradient(180deg,#eaf2fc,#f4f8fd 60%)}
.login-card{width:100%;max-width:436px;background:#fff;border-radius:22px;box-shadow:var(--shadow-xl);overflow:hidden;animation:pop .5s var(--ease)}
@keyframes pop{from{opacity:0;transform:translateY(18px) scale(.98)}to{opacity:1;transform:none}}
.login-head{background:var(--navy);padding:30px 34px 26px;color:#fff;position:relative;overflow:hidden}
.login-head::after{content:'';position:absolute;width:210px;height:210px;border-radius:50%;background:radial-gradient(circle,rgba(255,225,0,.2),transparent 70%);right:-60px;top:-70px}
.login-head .mark{width:48px;height:48px;border-radius:13px;background:var(--yellow);color:var(--navy);display:grid;place-items:center;font-weight:900;font-size:14px;letter-spacing:-.2px;margin-bottom:14px;overflow:hidden}
.login-head h1{font-size:22px;font-weight:800;letter-spacing:-.3px}
.login-head p{font-size:12.5px;color:var(--lb);margin-top:4px}
.login-body{padding:28px 34px 32px}
.fgroup{margin-bottom:15px}
.fgroup label{display:block;font-size:12px;font-weight:700;color:var(--blue);letter-spacing:.4px;text-transform:uppercase;margin-bottom:6px}
.inp{width:100%;height:46px;border:1.5px solid var(--line);border-radius:11px;padding:0 14px;outline:0;transition:.2s;background:#fbfdff}
.inp:focus{border-color:var(--blue);background:#fff;box-shadow:0 0 0 4px rgba(58,92,170,.1)}
textarea.inp{height:auto;padding:11px 14px;resize:vertical;min-height:84px;line-height:1.55}
select.inp{cursor:pointer}
.btn{height:46px;border:0;border-radius:11px;cursor:pointer;font-weight:700;display:inline-flex;align-items:center;justify-content:center;gap:8px;padding:0 20px;transition:.22s var(--ease);white-space:nowrap}
.btn-primary{background:var(--navy);color:#fff;box-shadow:0 6px 20px rgba(0,48,71,.26)}
.btn-primary:hover{transform:translateY(-2px);box-shadow:0 12px 30px rgba(0,48,71,.34)}
.btn-primary:disabled{opacity:.55;cursor:not-allowed;transform:none;box-shadow:none}
.btn-gold{background:var(--yellow);color:var(--navy)}
.btn-gold:hover{filter:brightness(1.05)}
.btn-ghost{background:#fff;color:var(--navy);border:1.5px solid var(--line)}
.btn-ghost:hover{border-color:var(--blue);background:var(--pale)}
.btn-danger{background:#fdeaea;color:var(--red);border:1.5px solid #f6cccc}
.btn-danger:hover{background:#fbdada}
.btn-sm{height:36px;padding:0 14px;font-size:13px;border-radius:9px}
.btn-block{width:100%}
.login-alt{text-align:center;margin-top:16px;font-size:13px;color:var(--muted)}
.login-alt b{color:var(--blue);cursor:pointer;font-weight:700}
.login-alt b:hover{text-decoration:underline}
.msg{border-radius:10px;padding:11px 14px;font-size:13px;margin-bottom:14px;display:none;line-height:1.5}
.msg.err{background:#fdeaea;color:#a83232;border-left:3px solid var(--red);display:block}
.msg.ok{background:#e9f7ef;color:#1d6d41;border-left:3px solid var(--green);display:block}
.msg.info{background:var(--pale);color:var(--blue);border-left:3px solid var(--blue);display:block}
.otp-inp{letter-spacing:12px;font-size:22px;font-weight:800;text-align:center;color:var(--navy)}

/* ============ SHELL ============ */
.app{display:none;min-height:100vh}
.app.on{display:block}
.sidebar{position:fixed;left:0;top:0;bottom:0;width:var(--sbw);background:var(--navy);color:#fff;z-index:90;display:flex;flex-direction:column;transition:transform .3s var(--ease)}
.sb-brand{padding:20px 20px 16px;display:flex;align-items:center;gap:11px;border-bottom:1px solid rgba(255,255,255,.08)}
.sb-brand .mark{width:40px;height:40px;border-radius:11px;background:var(--yellow);color:var(--navy);display:grid;place-items:center;font-weight:900;font-size:11.5px;letter-spacing:-.2px;flex-shrink:0;overflow:hidden}
.sb-brand b{font-size:14.5px;line-height:1.2;display:block}
.sb-brand span{font-size:9.5px;letter-spacing:1.3px;text-transform:uppercase;color:var(--lb);display:block;margin-top:2px}
.sb-nav{flex:1;overflow-y:auto;padding:14px 12px}
.sb-nav::-webkit-scrollbar{width:0}
.sb-sec{font-size:9.5px;letter-spacing:1.6px;text-transform:uppercase;color:rgba(207,226,243,.5);font-weight:700;padding:14px 12px 7px}
.nv{display:flex;align-items:center;gap:11px;padding:10px 12px;border-radius:10px;cursor:pointer;font-size:13.8px;font-weight:600;color:rgba(255,255,255,.78);transition:.18s;margin-bottom:2px}
.nv:hover{background:rgba(255,255,255,.09);color:#fff}
.nv.on{background:var(--blue);color:#fff;box-shadow:0 4px 14px rgba(58,92,170,.4)}
.nv .ic{width:19px;height:19px;flex-shrink:0;stroke-width:1.9}
.nv .badge{margin-left:auto;background:var(--yellow);color:var(--navy);font-size:10.5px;font-weight:800;padding:1px 7px;border-radius:20px}
.sb-user{padding:14px;border-top:1px solid rgba(255,255,255,.08);display:flex;align-items:center;gap:10px}
.avatar{width:36px;height:36px;border-radius:50%;background:var(--blue);display:grid;place-items:center;font-weight:800;font-size:13px;color:#fff;flex-shrink:0}
.sb-user .info{flex:1;min-width:0}
.sb-user .info b{display:block;font-size:13px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.sb-user .info span{display:block;font-size:10.5px;color:var(--lb);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.icon-btn{width:32px;height:32px;border-radius:9px;border:0;background:rgba(255,255,255,.1);color:#fff;cursor:pointer;display:grid;place-items:center;transition:.18s;flex-shrink:0}
.icon-btn:hover{background:rgba(255,255,255,.22)}
.icon-btn svg{width:16px;height:16px}

.main{margin-left:var(--sbw);min-height:100vh}
.topbar{position:sticky;top:0;z-index:60;height:64px;background:rgba(255,255,255,.88);backdrop-filter:saturate(180%) blur(18px);border-bottom:1px solid var(--line);display:flex;align-items:center;gap:14px;padding:0 26px}
.topbar h2{font-size:18px;font-weight:800;color:var(--navy);letter-spacing:-.3px}
.topbar .sub{font-size:12px;color:var(--muted);margin-top:-2px}
.topbar .spacer{flex:1}
.burger{display:none}
.conn{display:flex;align-items:center;gap:7px;font-size:11.5px;color:var(--muted);background:var(--pale);border-radius:20px;padding:6px 12px}
.dot{width:7px;height:7px;border-radius:50%;background:var(--green)}
.dot.off{background:var(--red)} .dot.load{background:var(--orange);animation:blink 1s infinite}
@keyframes blink{50%{opacity:.3}}
.view{padding:24px 26px 60px;display:none;animation:fade .3s var(--ease)}
.view.on{display:block}
@keyframes fade{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}

/* ============ COMPONENTS ============ */
.card{background:#fff;border:1px solid var(--line);border-radius:16px;box-shadow:var(--shadow-sm)}
.card-h{padding:16px 20px;border-bottom:1px solid var(--line);display:flex;align-items:center;gap:12px}
.card-h h3{font-size:15px;font-weight:800;color:var(--navy)}
.card-h .spacer{flex:1}
.card-b{padding:18px 20px}
.grid{display:grid;gap:16px}
.g4{grid-template-columns:repeat(4,1fr)}
.g3{grid-template-columns:repeat(3,1fr)}
.g2{grid-template-columns:repeat(2,1fr)}
.kpi{background:#fff;border:1px solid var(--line);border-radius:16px;padding:18px 20px;box-shadow:var(--shadow-sm);position:relative;overflow:hidden;transition:.25s var(--ease)}
.kpi:hover{transform:translateY(-3px);box-shadow:var(--shadow-md)}
.kpi::before{content:'';position:absolute;left:0;top:0;bottom:0;width:4px;background:var(--blue)}
.kpi.navy::before{background:var(--navy)} .kpi.gold::before{background:var(--yellow)}
.kpi.green::before{background:var(--green)} .kpi.orange::before{background:var(--orange)}
.kpi .lb{font-size:10.5px;font-weight:700;letter-spacing:1.2px;text-transform:uppercase;color:var(--blue)}
.kpi .vl{font-size:30px;font-weight:850;color:var(--navy);letter-spacing:-1.2px;line-height:1.15;margin-top:6px}
.kpi .sub{font-size:11.5px;color:var(--muted);margin-top:3px}
.chartbox{position:relative;height:250px}
.chartbox.tall{height:300px}

table.tbl{width:100%;border-collapse:collapse;font-size:13.5px}
table.tbl th{background:var(--lb);color:var(--navy);font-weight:700;font-size:11.5px;letter-spacing:.5px;text-transform:uppercase;padding:10px 12px;text-align:left;white-space:nowrap;position:sticky;top:0;z-index:2}
table.tbl td{padding:11px 12px;border-bottom:1px solid var(--line);vertical-align:middle}
table.tbl tbody tr:hover{background:var(--pale)}
.tbl-scroll{overflow:auto;max-height:520px;border-radius:12px;border:1px solid var(--line)}

.tag{display:inline-flex;align-items:center;gap:5px;font-size:11px;font-weight:700;padding:3px 10px;border-radius:20px;white-space:nowrap}
.tag.plan{background:var(--pale);color:var(--blue)}
.tag.completed{background:#e9f7ef;color:var(--green)}
.tag.cancel{background:#f1f3f5;color:#868e96}
.tag.pass{background:#e9f7ef;color:var(--green)}
.tag.fail{background:#fdeaea;color:var(--red)}
.tag.gold{background:var(--cream);color:#8a6d00;border:1px solid var(--yellow)}
.tag.product{background:#eaf1ff;color:var(--blue)}
.tag.sop{background:#f3edff;color:#6d3fd4}
.tag.compliance{background:#ffeee4;color:#c05a1c}
.tag.skill{background:#e6f7f8;color:#0d7a86}
.tag.admin{background:var(--navy);color:var(--yellow)}
.tag.trainer{background:var(--blue);color:#fff}
.tag.audience{background:#eef2f7;color:#5a6b80}

.empty{text-align:center;padding:50px 20px;color:var(--muted)}
.empty svg{width:46px;height:46px;opacity:.3;margin:0 auto 12px;display:block}
.empty b{display:block;color:var(--navy);font-size:15px;margin-bottom:5px}

.pill-row{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:16px}
.pill{height:34px;padding:0 14px;border-radius:20px;border:1.5px solid var(--line);background:#fff;cursor:pointer;font-size:12.8px;font-weight:600;color:var(--muted);transition:.18s;display:inline-flex;align-items:center;gap:6px}
.pill:hover{border-color:var(--blue);color:var(--blue)}
.pill.on{background:var(--navy);border-color:var(--navy);color:#fff}
.pill .n{background:rgba(0,0,0,.09);border-radius:12px;padding:0 6px;font-size:11px}
.pill.on .n{background:rgba(255,255,255,.22)}

.toolbar{display:flex;gap:10px;align-items:center;flex-wrap:wrap;margin-bottom:16px}
.search{position:relative;flex:1;min-width:200px;max-width:340px}
.search input{width:100%;height:40px;border:1.5px solid var(--line);border-radius:20px;padding:0 16px 0 40px;outline:0;background:#fff;transition:.2s}
.search input:focus{border-color:var(--blue);box-shadow:0 0 0 4px rgba(58,92,170,.09)}
.search svg{position:absolute;left:14px;top:11px;width:17px;height:17px;color:var(--muted)}

/* session cards */
.s-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(330px,1fr));gap:16px}
.s-card{background:#fff;border:1px solid var(--line);border-radius:16px;overflow:hidden;box-shadow:var(--shadow-sm);cursor:pointer;transition:.25s var(--ease);display:flex;flex-direction:column}
.s-card:hover{transform:translateY(-4px);box-shadow:var(--shadow-md);border-color:var(--lb)}
.s-card .top{padding:14px 17px 0;display:flex;gap:8px;align-items:center;flex-wrap:wrap}
.s-card .bd{padding:11px 17px 15px;flex:1}
.s-card h4{font-size:15px;font-weight:750;color:var(--navy);line-height:1.38;margin-bottom:7px;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.s-card .purpose{font-size:12.5px;color:var(--muted);line-height:1.5;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;margin-bottom:11px}
.s-meta{display:flex;flex-wrap:wrap;gap:6px 14px;font-size:12px;color:var(--muted)}
.s-meta span{display:inline-flex;align-items:center;gap:5px}
.s-meta svg{width:13px;height:13px;flex-shrink:0}
.s-card .ft{border-top:1px solid var(--line);padding:10px 17px;display:flex;align-items:center;gap:8px;background:#fcfdff}
.prog{flex:1;height:6px;border-radius:4px;background:var(--line);overflow:hidden}
.prog i{display:block;height:100%;background:linear-gradient(90deg,var(--blue),var(--green));border-radius:4px;transition:width .5s var(--ease)}
.ft .pct{font-size:11.5px;font-weight:700;color:var(--navy)}

/* modal / drawer */
.ov{position:fixed;inset:0;background:rgba(7,25,45,.5);backdrop-filter:blur(3px);z-index:200;display:none;align-items:center;justify-content:center;padding:20px}
.ov.on{display:flex;animation:fade .2s}
.modal{background:#fff;border-radius:20px;width:100%;max-width:680px;max-height:90vh;display:flex;flex-direction:column;box-shadow:var(--shadow-xl);animation:pop .3s var(--ease)}
.modal.wide{max-width:1000px}
.modal.xwide{max-width:1180px}
.m-h{padding:19px 24px;border-bottom:1px solid var(--line);display:flex;align-items:center;gap:12px;flex-shrink:0}
.m-h h3{font-size:17px;font-weight:800;color:var(--navy);flex:1}
.m-h .sub{font-size:12px;color:var(--muted);font-weight:400;display:block;margin-top:1px}
.m-b{padding:22px 24px;overflow-y:auto;flex:1}
.m-f{padding:15px 24px;border-top:1px solid var(--line);display:flex;gap:10px;justify-content:flex-end;flex-shrink:0;background:#fcfdff;border-radius:0 0 20px 20px}
.row2{display:grid;grid-template-columns:1fr 1fr;gap:14px}
.row3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:14px}

.toast-wrap{position:fixed;bottom:24px;right:24px;z-index:900;display:flex;flex-direction:column;gap:10px;max-width:380px}
.toast{background:var(--navy);color:#fff;padding:13px 18px;border-radius:12px;box-shadow:var(--shadow-xl);font-size:13.5px;display:flex;gap:10px;align-items:flex-start;animation:slidein .3s var(--ease)}
.toast.err{background:#a83232} .toast.ok{background:#1d6d41}
.toast svg{width:17px;height:17px;flex-shrink:0;margin-top:2px}
@keyframes slidein{from{opacity:0;transform:translateX(30px)}to{opacity:1;transform:none}}

.loading{position:fixed;inset:0;background:rgba(244,248,253,.82);backdrop-filter:blur(3px);z-index:800;display:none;align-items:center;justify-content:center;flex-direction:column;gap:16px}
.loading.on{display:flex}
.spinner{width:42px;height:42px;border:3.5px solid var(--lb);border-top-color:var(--navy);border-radius:50%;animation:spin .8s linear infinite}
@keyframes spin{to{transform:rotate(360deg)}}
.loading p{font-size:13.5px;color:var(--navy);font-weight:600}

/* calendar */
.cal-head{display:flex;align-items:center;gap:12px;margin-bottom:16px}
.cal-head h3{font-size:18px;font-weight:800;color:var(--navy);min-width:190px;text-align:center}
.cal{display:grid;grid-template-columns:repeat(7,1fr);gap:1px;background:var(--line);border:1px solid var(--line);border-radius:14px;overflow:hidden}
.cal .dow{background:var(--navy);color:#fff;font-size:11px;font-weight:700;letter-spacing:.7px;text-transform:uppercase;padding:9px 6px;text-align:center}
.cal .day{background:#fff;min-height:112px;padding:7px 8px;position:relative;transition:.15s}
.cal .day.out{background:#fafbfd}
.cal .day.today{background:var(--cream)}
.cal .day .n{font-size:12px;font-weight:700;color:var(--muted);margin-bottom:5px}
.cal .day.today .n{color:var(--navy);background:var(--yellow);width:22px;height:22px;border-radius:50%;display:grid;place-items:center;font-size:11.5px}
.ev{font-size:10.8px;padding:3px 7px;border-radius:6px;margin-bottom:3px;cursor:pointer;line-height:1.35;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;font-weight:600;border-left:3px solid}
.ev.plan{background:var(--pale);color:var(--blue);border-color:var(--blue)}
.ev.completed{background:#e9f7ef;color:#1d6d41;border-color:var(--green)}
.ev.cancel{background:#f1f3f5;color:#868e96;border-color:#adb5bd;text-decoration:line-through}
.ev:hover{filter:brightness(.95);transform:translateX(2px)}

/* quiz */
/* #quizShell là con trực tiếp của .modal nên phải tự dựng lại flex layout,
   nếu không phần thân bài test sẽ tràn khỏi màn hình thay vì cuộn riêng. */
#quizShell{display:flex;flex-direction:column;max-height:90vh;min-height:0}
#quizShell .m-b{flex:1;min-height:0;overflow-y:auto}
#quizShell .m-f,#quizShell .quiz-top,#quizShell .m-h{flex-shrink:0}
.quiz-top{z-index:30;background:#fff;border-bottom:2px solid var(--line);padding:14px 22px;display:flex;align-items:center;gap:16px;border-radius:16px 16px 0 0}
.timer{display:flex;align-items:center;gap:9px;background:var(--navy);color:#fff;border-radius:30px;padding:8px 18px;font-weight:800;font-size:17px;letter-spacing:.5px;font-variant-numeric:tabular-nums}
.timer.warn{background:var(--orange);animation:pulse 1s infinite}
.timer.danger{background:var(--red);animation:pulse .6s infinite}
@keyframes pulse{50%{opacity:.75}}
.qprog{flex:1;height:8px;border-radius:5px;background:var(--line);overflow:hidden}
.qprog i{display:block;height:100%;background:linear-gradient(90deg,var(--blue),var(--navy));transition:width .3s}
.q-item{background:#fff;border:1.5px solid var(--line);border-radius:16px;padding:20px 22px;margin-bottom:14px;transition:.2s}
.q-item.answered{border-color:var(--lb);background:#fcfdff}
.q-num{display:inline-flex;align-items:center;justify-content:center;width:26px;height:26px;border-radius:8px;background:var(--navy);color:#fff;font-size:12.5px;font-weight:800;margin-right:10px;flex-shrink:0}
.q-text{font-size:15px;font-weight:650;color:var(--navy);line-height:1.5;margin-bottom:14px;display:flex}
.opt{display:flex;align-items:flex-start;gap:11px;padding:12px 15px;border:1.5px solid var(--line);border-radius:11px;margin-bottom:8px;cursor:pointer;transition:.16s;background:#fff}
.opt:hover{border-color:var(--blue);background:var(--pale)}
.opt.sel{border-color:var(--navy);background:var(--pale);box-shadow:0 0 0 3px rgba(0,48,71,.07)}
.opt .k{width:25px;height:25px;border-radius:50%;border:1.8px solid var(--line);display:grid;place-items:center;font-size:12px;font-weight:800;color:var(--muted);flex-shrink:0;transition:.16s}
.opt.sel .k{background:var(--navy);border-color:var(--navy);color:#fff}
.opt.correct{border-color:var(--green);background:#f0faf4}
.opt.correct .k{background:var(--green);border-color:var(--green);color:#fff}
.opt.wrong{border-color:var(--red);background:#fdf2f2}
.opt.wrong .k{background:var(--red);border-color:var(--red);color:#fff}
.opt .t{flex:1;font-size:14px;line-height:1.5}
.explain{background:var(--cream);border-left:4px solid var(--yellow);padding:11px 15px;border-radius:0 9px 9px 0;font-size:13px;margin-top:10px;line-height:1.55}

.result-hero{text-align:center;padding:34px 22px}
.result-ring{width:150px;height:150px;margin:0 auto 20px;position:relative}
.result-ring svg{transform:rotate(-90deg)}
.result-ring .txt{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center}
.result-ring .txt b{font-size:36px;font-weight:850;color:var(--navy);letter-spacing:-1.5px;line-height:1}
.result-ring .txt span{font-size:11px;color:var(--muted);font-weight:600;letter-spacing:.8px;margin-top:2px}

/* quiz builder */
.qb-item{border:1.5px solid var(--line);border-radius:14px;padding:16px 18px;margin-bottom:12px;background:#fcfdff}
.qb-head{display:flex;align-items:center;gap:10px;margin-bottom:12px}
.qb-head .n{width:26px;height:26px;border-radius:8px;background:var(--navy);color:#fff;display:grid;place-items:center;font-size:12.5px;font-weight:800}
.qb-opt{display:flex;align-items:center;gap:9px;margin-bottom:7px}
.qb-opt .key{width:30px;height:38px;border-radius:9px;background:var(--lb);color:var(--navy);display:grid;place-items:center;font-weight:800;font-size:12.5px;cursor:pointer;transition:.16s;flex-shrink:0;border:2px solid transparent}
.qb-opt .key.on{background:var(--green);color:#fff;border-color:var(--green)}
.qb-opt .inp{height:38px}

/* file list */
.file-row{display:flex;align-items:center;gap:12px;padding:11px 14px;border:1px solid var(--line);border-radius:12px;margin-bottom:8px;background:#fff;transition:.18s}
.file-row:hover{border-color:var(--lb);background:var(--pale)}
.file-ic{width:38px;height:38px;border-radius:10px;display:grid;place-items:center;flex-shrink:0;font-size:10px;font-weight:800;color:#fff}
.file-ic.pdf{background:#d64545} .file-ic.slide{background:#e07b39}
.file-ic.doc{background:#3A5CAA} .file-ic.sheet{background:#2f9e5e}
.file-ic.image{background:#7c3aed} .file-ic.video{background:#0d7a86}
.file-ic.file{background:#7387a0}
.file-row .nm{flex:1;min-width:0}
.file-row .nm b{display:block;font-size:13.5px;font-weight:650;color:var(--navy);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.file-row .nm span{font-size:11.5px;color:var(--muted)}
.dropzone{border:2px dashed var(--lb);border-radius:14px;padding:26px;text-align:center;color:var(--muted);cursor:pointer;transition:.2s;background:#fcfdff}
.dropzone:hover,.dropzone.drag{border-color:var(--blue);background:var(--pale);color:var(--blue)}
.dropzone svg{width:34px;height:34px;opacity:.5;margin:0 auto 9px;display:block}

.viewer{width:100%;height:min(70vh,640px);border:1px solid var(--line);border-radius:12px;background:#f8fafc}

/* chips multiselect */
.chips{display:flex;flex-wrap:wrap;gap:7px;padding:9px;border:1.5px solid var(--line);border-radius:11px;min-height:46px;background:#fbfdff;align-items:center}
.chip{display:inline-flex;align-items:center;gap:6px;background:var(--pale);color:var(--blue);border:1px solid var(--lb);border-radius:20px;padding:3px 9px;font-size:12px;font-weight:600}
.chip b{cursor:pointer;opacity:.6;font-size:14px;line-height:1}
.chip b:hover{opacity:1;color:var(--red)}

.hint{font-size:12px;color:var(--muted);margin-top:5px;line-height:1.5}
.sep{height:1px;background:var(--line);margin:18px 0}
.sec-title{font-size:12px;font-weight:800;letter-spacing:1.2px;text-transform:uppercase;color:var(--blue);margin-bottom:12px;display:flex;align-items:center;gap:8px}
.sec-title::after{content:'';flex:1;height:1px;background:var(--line)}

@media(max-width:1180px){.g4{grid-template-columns:repeat(2,1fr)}.g3{grid-template-columns:1fr 1fr}}
@media(max-width:900px){
  .sidebar{transform:translateX(-100%)} .sidebar.open{transform:none;box-shadow:var(--shadow-xl)}
  .main{margin-left:0} .burger{display:grid}
  .g4,.g3,.g2,.row2,.row3{grid-template-columns:1fr}
  .view{padding:18px 16px 50px} .topbar{padding:0 16px}
  .cal .day{min-height:78px;padding:5px} .cal .day .n{font-size:11px}
  .ev{font-size:9.5px;padding:2px 5px}
  .toast-wrap{left:16px;right:16px;bottom:16px;max-width:none}
}
</style>
</head>
<body>

<!-- ================= LOGIN ================= -->
<div class="login-wrap" id="loginWrap">
  <div class="login-card">
    <div class="login-head">
      <div class="mark">MANI</div>
      <h1 id="loginTitle">MMH Training Hub</h1>
      <p>Hệ thống quản lý đào tạo — Mani Medical Hanoi</p>
    </div>
