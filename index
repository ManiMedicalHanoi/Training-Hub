          <button class="btn btn-primary btn-block" id="btnVerify">Xác nhận &amp; đăng nhập</button>
        </div>
        <div class="login-alt">Đã có PIN? <b id="goLogin">Quay lại đăng nhập</b></div>
      </div>
    </div>
  </div>
</div>

<!-- ================= APP ================= -->
<div class="app" id="app">

  <aside class="sidebar" id="sidebar">
