};

/* ==========================================================================
   QUIZ BUILDER (trainer)
   ========================================================================== */
async function openQuizBuilder(sid){
  S.qbSid = sid;
  const s = S.sessions.find(x=>x.sid===sid);
  $('qbSub').textContent = s ? s.topic : '';
  $('ovQuizBuilder').classList.add('on');
  $('qbBody').innerHTML = '<div class="empty"><div class="spinner" style="margin:0 auto"></div></div>';
  let cfg = null, qs = [];
  try{ const r = await apiGet('getQuiz',{sid:sid}); cfg = r.config; qs = r.questions||[]; }catch(e){}
  S.qbQuestions = qs.length ? qs.map(q=>({type:q.type,question:q.question,a:q.a,b:q.b,c:q.c,d:q.d,correct:q.correct,points:q.points,explanation:q.explanation}))
                            : [blankQ()];
  S.qbCfg = cfg || {
    passScore: nnum(S.config.DEFAULT_PASS_SCORE)||70,
    durationMin: nnum(S.config.DEFAULT_DURATION_MIN)||15,
    maxAttempts: nnum(S.config.DEFAULT_MAX_ATTEMPTS)||2,
    shuffle:true, showResult:true, active:true
  };
  renderQB();
}
function blankQ(){ return {type:'single',question:'',a:'',b:'',c:'',d:'',correct:'A',points:1,explanation:''}; }
function renderQB(){
  const c = S.qbCfg;
  $('qbBody').innerHTML = `
    <div class="card" style="box-shadow:none;margin-bottom:18px"><div class="card-b">
      <div class="sec-title">Cấu hình bài đánh giá</div>
      <div class="row3">
        <div class="fgroup"><label>Điểm đạt (%)</label><input class="inp" id="q_pass" type="number" min="1" max="100" value="${c.passScore}"></div>
        <div class="fgroup"><label>Thời gian làm bài (phút)</label><input class="inp" id="q_dur" type="number" min="1" max="180" value="${c.durationMin}"></div>
        <div class="fgroup"><label>Số lượt được làm</label><input class="inp" id="q_att" type="number" min="1" max="10" value="${c.maxAttempts}"></div>
      </div>
      <div style="display:flex;gap:20px;flex-wrap:wrap">
        <label style="display:flex;align-items:center;gap:8px;font-size:13.5px;cursor:pointer"><input type="checkbox" id="q_shuffle" ${c.shuffle?'checked':''} style="width:17px;height:17px;accent-color:var(--navy)">Xáo trộn thứ tự câu hỏi</label>
        <label style="display:flex;align-items:center;gap:8px;font-size:13.5px;cursor:pointer"><input type="checkbox" id="q_show" ${c.showResult!==false?'checked':''} style="width:17px;height:17px;accent-color:var(--navy)">Hiện đáp án sau khi nộp</label>
        <label style="display:flex;align-items:center;gap:8px;font-size:13.5px;cursor:pointer"><input type="checkbox" id="q_active" ${c.active!==false?'checked':''} style="width:17px;height:17px;accent-color:var(--navy)">Phát hành ngay cho học viên</label>
      </div>
    </div></div>
    <div class="sec-title">Câu hỏi (${S.qbQuestions.length})</div>
    <div id="qbList">${S.qbQuestions.map(qbItem).join('')}</div>`;
}
function qbItem(q,i){
  const isTF = q.type==='truefalse';
  return `<div class="qb-item" data-i="${i}">
    <div class="qb-head">
      <span class="n">${i+1}</span>
      <select class="inp" style="height:36px;width:auto" onchange="qbSet(${i},'type',this.value)">
        <option value="single" ${!isTF?'selected':''}>Trắc nghiệm</option>
        <option value="truefalse" ${isTF?'selected':''}>Đúng / Sai</option>
      </select>
      <input class="inp" style="height:36px;width:92px" type="number" min="1" value="${q.points||1}" onchange="qbSet(${i},'points',this.value)" title="Số điểm">
      <div style="flex:1"></div>
      <button class="icon-btn" style="background:#fdeaea;color:var(--red)" onclick="qbDel(${i})" title="Xoá câu">✕</button>
    </div>
    <div class="fgroup"><textarea class="inp" style="min-height:62px" placeholder="Nội dung câu hỏi…" onchange="qbSet(${i},'question',this.value)">${esc(q.question)}</textarea></div>
    ${isTF
      ? `<div style="display:flex;gap:9px">
          <button class="btn btn-sm ${q.correct==='A'?'btn-primary':'btn-ghost'}" style="flex:1" onclick="qbSet(${i},'correct','A');renderQBList()">Đáp án: ĐÚNG</button>
          <button class="btn btn-sm ${q.correct==='B'?'btn-primary':'btn-ghost'}" style="flex:1" onclick="qbSet(${i},'correct','B');renderQBList()">Đáp án: SAI</button>
        </div>`
      : ['a','b','c','d'].map(k=>`<div class="qb-opt">
          <div class="key ${q.correct===k.toUpperCase()?'on':''}" onclick="qbSet(${i},'correct','${k.toUpperCase()}');renderQBList()" title="Chọn làm đáp án đúng">${k.toUpperCase()}</div>
          <input class="inp" placeholder="Phương án ${k.toUpperCase()}${k==='c'||k==='d'?' (không bắt buộc)':''}" value="${esc(q[k])}" onchange="qbSet(${i},'${k}',this.value)">
        </div>`).join('')}
    <div class="fgroup" style="margin-top:9px;margin-bottom:0"><input class="inp" style="height:38px" placeholder="Giải thích đáp án (hiện sau khi nộp bài)" value="${esc(q.explanation)}" onchange="qbSet(${i},'explanation',this.value)"></div>
  </div>`;
}
function renderQBList(){ $('qbList').innerHTML = S.qbQuestions.map(qbItem).join(''); }
function qbSet(i,k,v){ S.qbQuestions[i][k] = (k==='points')? Number(v)||1 : v; if(k==='type') renderQBList(); }
function qbDel(i){ if(S.qbQuestions.length<=1) return err('Cần ít nhất 1 câu hỏi.'); S.qbQuestions.splice(i,1); renderQB(); }
$('btnAddQ').onclick = ()=>{
  saveQBCfg(); S.qbQuestions.push(blankQ()); renderQB();
  setTimeout(()=>{ const l=$('qbList'); if(l) l.lastElementChild.scrollIntoView({behavior:'smooth',block:'center'}); },60);
};
function saveQBCfg(){
  if(!$('q_pass')) return;
  S.qbCfg = {
    passScore:Number($('q_pass').value)||70, durationMin:Number($('q_dur').value)||15,
    maxAttempts:Number($('q_att').value)||2, shuffle:$('q_shuffle').checked,
    showResult:$('q_show').checked, active:$('q_active').checked
  };
}
$('btnSaveQuiz').onclick = async ()=>{
  saveQBCfg();
  const c = S.qbCfg;
  busy(true,'Đang lưu bộ câu hỏi…');
  try{
    const r = await apiPost('saveQuiz', Object.assign({sid:S.qbSid, questions:S.qbQuestions}, c));
    ok(r.message); closeAll(); await boot();
  }catch(e){ err(e.message); } finally{ busy(false); }
};
</script>

<script>
/* ==========================================================================
   LÀM BÀI ĐÁNH GIÁ (có đếm ngược)
   ========================================================================== */
async function startQuiz(sid){
  busy(true,'Đang chuẩn bị đề…');
  let r;
  try{ r = await apiGet('quizStart',{sid:sid}); }
  catch(e){ busy(false); return err(e.message); }
  busy(false);
  closeAll();
  S.attempt = {
    id:r.attemptId, sid:sid, questions:r.questions, answers:{},
    endAt: Date.now() + r.durationSec*1000, passScore:r.passScore,
    session:r.session, attemptNo:r.attemptNo, maxAttempts:r.maxAttempts, total:r.durationSec
  };
  renderQuiz();
  $('ovQuiz').classList.add('on');
  startTimer();
}
function renderQuiz(){
  const a = S.attempt;
  $('quizShell').innerHTML = `
    <div class="quiz-top">
      <div>
        <div style="font-size:11px;letter-spacing:1.2px;text-transform:uppercase;color:var(--blue);font-weight:700">Bài đánh giá sau đào tạo</div>
        <div style="font-size:15px;font-weight:800;color:var(--navy);max-width:420px;line-height:1.3">${esc(a.session.topic)}</div>
      </div>
      <div style="flex:1"></div>
      <div style="text-align:right">
        <div style="font-size:11px;color:var(--muted)">Lượt ${a.attemptNo}/${a.maxAttempts} · Đạt từ ${a.passScore}%</div>
        <div style="font-size:12px;color:var(--navy);font-weight:700"><span id="qDone">0</span>/${a.questions.length} câu đã trả lời</div>
      </div>
      <div class="timer" id="qTimer">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:17px;height:17px"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
        <span id="qClock">--:--</span>
      </div>
    </div>
    <div style="padding:0 22px 6px"><div class="qprog"><i id="qBar" style="width:0%"></i></div></div>
    <div class="m-b" style="padding:18px 22px" id="quizBody">
      ${a.questions.map(q=>`
        <div class="q-item" id="qi_${q.qid}">
          <div class="q-text"><span class="q-num">${q.no}</span><span>${esc(q.question)}${q.points>1?` <span class="tag gold" style="margin-left:6px">${q.points} điểm</span>`:''}</span></div>
          ${q.options.map(o=>`<div class="opt" onclick="pick('${q.qid}','${o.k}')" id="op_${q.qid}_${o.k}">
            <div class="k">${o.k}</div><div class="t">${esc(o.t)}</div></div>`).join('')}
        </div>`).join('')}
    </div>
    <div class="m-f">
      <button class="btn btn-ghost btn-sm" onclick="abandonQuiz()">Thoát (huỷ bài)</button>
      <div style="flex:1"></div>
      <button class="btn btn-primary btn-sm" id="btnSubmitQuiz" onclick="submitQuiz(false)">Nộp bài</button>
    </div>`;
}
function pick(qid,k){
  const a = S.attempt; if(!a) return;
  a.answers[qid] = k;
  const item = $('qi_'+qid);
  item.querySelectorAll('.opt').forEach(o=>o.classList.remove('sel'));
  $('op_'+qid+'_'+k).classList.add('sel');
  item.classList.add('answered');
  const n = Object.keys(a.answers).length;
  $('qDone').textContent = n;
  $('qBar').style.width = Math.round(n/a.questions.length*100)+'%';
}
function startTimer(){
  clearInterval(S.timerId);
  S.timerId = setInterval(()=>{
    const a = S.attempt; if(!a){ clearInterval(S.timerId); return; }
    const left = Math.max(0, Math.round((a.endAt - Date.now())/1000));
    const el = $('qClock'), box = $('qTimer');
    if(el) el.textContent = fmtSec(left);
    if(box){
      box.className = 'timer' + (left<=30 ? ' danger' : left<=120 ? ' warn' : '');
    }
    if(left<=0){ clearInterval(S.timerId); toast('Hết giờ — hệ thống tự động nộp bài.','err'); submitQuiz(true); }
  }, 250);
}
function abandonQuiz(){
  if(!confirm('Thoát sẽ huỷ bài làm hiện tại và vẫn tính là 1 lượt. Tiếp tục?')) return;
  clearInterval(S.timerId); S.attempt=null;
  $('ovQuiz').classList.remove('on');
}
async function submitQuiz(auto){
  const a = S.attempt; if(!a) return;
  const unanswered = a.questions.length - Object.keys(a.answers).length;
  if(!auto && unanswered>0 && !confirm(`Còn ${unanswered} câu chưa trả lời. Vẫn nộp bài?`)) return;
  clearInterval(S.timerId);
  const btn = $('btnSubmitQuiz'); if(btn){ btn.disabled = true; btn.textContent = 'Đang chấm…'; }
  busy(true,'Đang chấm điểm & cấp chứng chỉ…');
  try{
    const r = await apiPost('quizSubmit',{attemptId:a.id, answers:a.answers});
    S.attempt = null;
    renderQuizResult(r, a);
    await boot();
  }catch(e){
    err(e.message);
    if(btn){ btn.disabled=false; btn.textContent='Nộp bài'; }
  }finally{ busy(false); }
}
function renderQuizResult(r, a){
  const pass = r.pass, pct = r.percent;
  const C = 2*Math.PI*66;
  $('quizShell').innerHTML = `
    <div class="m-h"><h3>Kết quả bài đánh giá</h3><button class="icon-btn" data-close style="background:var(--pale);color:var(--navy)">✕</button></div>
    <div class="m-b">
      <div class="result-hero">
        <div class="result-ring">
          <svg width="150" height="150"><circle cx="75" cy="75" r="66" fill="none" stroke="#e6edf6" stroke-width="13"/>
          <circle cx="75" cy="75" r="66" fill="none" stroke="${pass?'#2f9e5e':'#d64545'}" stroke-width="13" stroke-linecap="round"
            stroke-dasharray="${C}" stroke-dashoffset="${C - C*Math.min(pct,100)/100}"/></svg>
          <div class="txt"><b>${pct}%</b><span>${r.score}/${r.maxScore} ĐIỂM</span></div>
        </div>
        <div style="font-size:23px;font-weight:850;color:${pass?'var(--green)':'var(--red)'};letter-spacing:-.5px;margin-bottom:6px">
          ${pass?'ĐẠT':'CHƯA ĐẠT'}</div>
        <div style="color:var(--muted);font-size:13.5px;max-width:460px;margin:0 auto 4px">${esc(r.message)}</div>
        <div style="color:var(--muted);font-size:12.5px">Điểm yêu cầu: ${r.passScore}% · Thời gian làm bài: ${fmtSec(r.durationSec)} · Lượt ${r.attemptNo}/${r.maxAttempts}</div>
        ${r.certificate?`<div style="margin-top:20px">
          <div style="background:var(--cream);border:1.5px solid var(--yellow);border-radius:13px;padding:16px 20px;max-width:460px;margin:0 auto">
            <div style="font-size:12px;font-weight:700;letter-spacing:1px;text-transform:uppercase;color:#8a6d00">Chứng chỉ đã được cấp</div>
            <div style="font-size:13px;color:var(--navy);margin:5px 0 11px">Số ${esc(r.certificate.certNo)}${r.certificate.emailed?' · Đã gửi email cho bạn và quản lý trực tiếp':''}</div>
            <a href="${esc(r.certificate.url)}" target="_blank" class="btn btn-primary btn-sm">Xem chứng chỉ PDF</a>
          </div></div>`:''}
      </div>
      ${(r.detail&&r.detail.length)?`<div class="sec-title">Chi tiết đáp án</div>${r.detail.map(d=>`
        <div class="q-item">
          <div class="q-text"><span class="q-num" style="background:${d.isCorrect?'var(--green)':'var(--red)'}">${d.no}</span><span>${esc(d.question)}</span></div>
          <div style="display:flex;gap:10px;flex-wrap:wrap;font-size:13px;margin-bottom:${d.explanation?'8px':'0'}">
            <span class="tag ${d.isCorrect?'pass':'fail'}">Bạn chọn: ${esc(d.given||'—')}</span>
            ${!d.isCorrect?`<span class="tag pass">Đáp án đúng: ${esc(d.correct)}</span>`:''}
          </div>
          ${d.explanation?`<div class="explain">${esc(d.explanation)}</div>`:''}
        </div>`).join('')}`:''}
    </div>
    <div class="m-f"><div style="flex:1"></div><button class="btn btn-primary btn-sm" data-close>Đóng</button></div>`;
}

/* ==========================================================================
   ĐÀO TẠO CỦA TÔI
   ========================================================================== */
function renderMyTraining(){
  const mine = S.sessions.filter(s=>s.status!=='Cancel' && (s.myStatus || s.myScore!=='' || s.hasQuiz));
  const assigned = S.sessions.filter(s=>s.myStatus);
  const done = assigned.filter(s=>s.myStatus==='Completed');
  const passed = assigned.filter(s=>s.myPass);
  const avg = done.length ? Math.round(done.reduce((a,s)=>a+nnum(s.myScore),0)/done.length) : 0;

  $('myKpi').innerHTML = [
    kpiCard('navy','Được phân công', assigned.length, 'Bài đào tạo'),
    kpiCard('green','Đã hoàn thành', done.length, assigned.length?Math.round(done.length/assigned.length*100)+'% tiến độ':'—'),
    kpiCard('gold','Đã đạt', passed.length, 'Có chứng chỉ'),
    kpiCard('orange','Điểm trung bình', avg+'%', 'Trên các bài đã làm')
  ].join('');

  const todo = S.sessions.filter(s=>s.hasQuiz && s.quizActive && !s.myPass && s.status!=='Cancel');
  $('myHint').textContent = todo.length ? todo.length+' bài đánh giá đang chờ bạn' : 'Bạn đã hoàn thành tất cả bài đánh giá đang mở';

  const list = mine.sort((a,b)=>(b.date||'').localeCompare(a.date||''));
  $('myList').innerHTML = list.length ? `<table class="tbl">
    <thead><tr><th>Ngày</th><th>Chủ đề</th><th>Nhóm</th><th>Trainer</th><th>Bài đánh giá</th><th>Kết quả</th><th></th></tr></thead>
    <tbody>${list.map(s=>`<tr>
      <td>${esc(s.dateText||'—')}</td>
      <td style="max-width:330px"><b style="color:var(--navy)">${esc(s.topic)}</b></td>
      <td><span class="tag ${catClass(s.category)}">${esc(s.category)}</span></td>
      <td>${esc(s.trainer)}</td>
      <td>${s.hasQuiz?`<span class="tag ${s.quizActive?'gold':'audience'}">${s.quizActive?'Đang mở':'Đã đóng'}</span>`:'<span style="color:var(--muted)">Không có</span>'}</td>
      <td>${s.myScore!==''?`<span class="tag ${s.myPass?'pass':'fail'}">${s.myScore}% ${s.myPass?'Đạt':'Chưa đạt'}</span>`:'<span style="color:var(--muted)">Chưa làm</span>'}</td>
      <td style="white-space:nowrap">
