$('calPrev').onclick = ()=>{ S.calDate.setMonth(S.calDate.getMonth()-1); renderCalendar(); };
$('calNext').onclick = ()=>{ S.calDate.setMonth(S.calDate.getMonth()+1); renderCalendar(); };
$('calToday').onclick = ()=>{ S.calDate = new Date(); renderCalendar(); };

function renderCalendar(){
  const d = S.calDate, y = d.getFullYear(), m = d.getMonth();
  $('calLabel').textContent = 'Tháng ' + (m+1) + ' / ' + y;
  const first = new Date(y, m, 1);
  let start = first.getDay(); start = start===0 ? 6 : start-1;   // tuần bắt đầu thứ Hai
  const days = new Date(y, m+1, 0).getDate();
  const prevDays = new Date(y, m, 0).getDate();
  const today = new Date(); today.setHours(0,0,0,0);

  const byDate = {};
  S.sessions.forEach(s=>{ if(s.date){ (byDate[s.date] = byDate[s.date]||[]).push(s); } });

  let html = ['T2','T3','T4','T5','T6','T7','CN'].map(x=>`<div class="dow">${x}</div>`).join('');
  const cells = Math.ceil((start+days)/7)*7;
  for(let i=0;i<cells;i++){
    const n = i - start + 1;
    let cy=y, cm=m, cd=n, out=false;
    if(n<1){ cd = prevDays+n; cm = m-1; out=true; if(cm<0){cm=11;cy--;} }
    else if(n>days){ cd = n-days; cm = m+1; out=true; if(cm>11){cm=0;cy++;} }
    const iso = cy+'-'+String(cm+1).padStart(2,'0')+'-'+String(cd).padStart(2,'0');
    const isToday = !out && new Date(cy,cm,cd).getTime()===today.getTime();
    const evs = byDate[iso]||[];
    html += `<div class="day ${out?'out':''} ${isToday?'today':''}">
      <div class="n">${cd}</div>
      ${evs.slice(0,4).map(s=>`<div class="ev ${statusClass(s.status)}" onclick="openDetail('${s.sid}')" title="${esc(s.topic)}">${esc(s.topic)}</div>`).join('')}
      ${evs.length>4?`<div style="font-size:10px;color:var(--muted);padding-left:4px">+${evs.length-4} buổi</div>`:''}
    </div>`;
  }
  $('calGrid').innerHTML = html;

  const ym = y+'-'+String(m+1).padStart(2,'0');
  const list = S.sessions.filter(s=>s.date && s.date.indexOf(ym)===0).sort((a,b)=>a.date.localeCompare(b.date));
  $('calList').innerHTML = list.length ? `<table class="tbl">
    <thead><tr><th>Ngày</th><th>Chủ đề</th><th>Nhóm</th><th>Hình thức</th><th>Trainer</th><th>Đối tượng</th><th>Trạng thái</th></tr></thead>
    <tbody>${list.map(s=>`<tr style="cursor:pointer" onclick="openDetail('${s.sid}')">
      <td><b style="color:var(--navy)">${esc(s.dateText)}</b>${s.timeFrom?`<div style="font-size:11px;color:var(--muted)">${esc(s.timeFrom)}${s.timeTo?'–'+esc(s.timeTo):''}</div>`:''}</td>
      <td style="max-width:320px"><b style="color:var(--navy)">${esc(s.topic)}</b></td>
      <td><span class="tag ${catClass(s.category)}">${esc(s.category)}</span></td>
      <td>${esc(s.type)}</td><td>${esc(s.trainer)}</td><td style="font-size:12.5px">${esc(s.audience)}</td>
      <td><span class="tag ${statusClass(s.status)}">${statusText(s.status)}</span></td>
    </tr>`).join('')}</tbody></table>` : emptyBox('Tháng này chưa có buổi đào tạo nào');
}
</script>

<script>
/* ==========================================================================
   SESSIONS
   ========================================================================== */
function fillFilters(){
  const cats = [...new Set(S.sessions.map(s=>s.category).filter(Boolean))];
  const trs  = [...new Set(S.sessions.map(s=>s.trainer).filter(Boolean))];
  $('fCategory').innerHTML = '<option value="">Tất cả nhóm chủ đề</option>' + cats.map(c=>`<option>${esc(c)}</option>`).join('');
  $('fTrainer').innerHTML  = '<option value="">Tất cả trainer</option>' + trs.map(c=>`<option>${esc(c)}</option>`).join('');
  $('rSession').innerHTML  = '<option value="">Tất cả buổi đào tạo</option>' +
    S.sessions.filter(s=>s.hasQuiz).map(s=>`<option value="${s.sid}">${esc(s.dateText+' — '+s.topic)}</option>`).join('');

  const counts = {
    all: S.sessions.filter(s=>s.status!=='Cancel').length,
    plan: S.sessions.filter(s=>s.status==='Plan').length,
    done: S.sessions.filter(s=>s.status==='Completed').length,
    quiz: S.sessions.filter(s=>s.hasQuiz && s.quizActive).length,
    mine: S.sessions.filter(s=>s.canEdit).length
  };
  $('quickFilters').innerHTML = [
    ['all','Tất cả',counts.all],['plan','Kế hoạch',counts.plan],['done','Hoàn thành',counts.done],
    ['quiz','Có bài đánh giá',counts.quiz]
  ].concat(S.user.isTrainer ? [['mine','Do tôi phụ trách',counts.mine]] : [])
   .map(([k,l,n])=>`<button class="pill ${S.filters.quick===k?'on':''}" data-q="${k}">${l}<span class="n">${n}</span></button>`).join('');
  document.querySelectorAll('#quickFilters .pill').forEach(p=>p.onclick=()=>{S.filters.quick=p.dataset.q;fillFilters();renderSessions()});
}
['sSearch','fCategory','fStatus','fTrainer'].forEach(id=>{
  $(id).addEventListener('input', ()=>{
    S.filters.q = $('sSearch').value.toLowerCase();
    S.filters.cat = $('fCategory').value; S.filters.status = $('fStatus').value; S.filters.trainer = $('fTrainer').value;
    renderSessions();
  });
});
function filteredSessions(){
  const f = S.filters;
  return S.sessions.filter(s=>{
    if(f.quick==='all' && s.status==='Cancel') return false;
    if(f.quick==='plan' && s.status!=='Plan') return false;
    if(f.quick==='done' && s.status!=='Completed') return false;
    if(f.quick==='quiz' && !(s.hasQuiz && s.quizActive)) return false;
    if(f.quick==='mine' && !s.canEdit) return false;
    if(f.cat && s.category!==f.cat) return false;
    if(f.status && s.status!==f.status) return false;
    if(f.trainer && s.trainer!==f.trainer) return false;
    if(f.q){
      const hay = (s.topic+' '+s.trainer+' '+s.audience+' '+s.category+' '+s.purpose).toLowerCase();
      if(hay.indexOf(f.q)<0) return false;
    }
    return true;
  }).sort((a,b)=>(b.date||'').localeCompare(a.date||''));
}
function renderSessions(){
  const list = filteredSessions();
  $('sessionGrid').innerHTML = list.length ? list.map(sessionCard).join('')
    : emptyBox('Không tìm thấy buổi đào tạo nào','Thử đổi bộ lọc hoặc từ khoá tìm kiếm');
}
function sessionCard(s){
  const pct = s.enrolled ? Math.round(s.passed/s.enrolled*100) : 0;
  return `<div class="s-card" onclick="openDetail('${s.sid}')">
    <div class="top">
      <span class="tag ${catClass(s.category)}">${esc(s.category||'—')}</span>
      <span class="tag ${statusClass(s.status)}">${statusText(s.status)}</span>
      ${s.hasQuiz ? `<span class="tag ${s.quizActive?'gold':'audience'}">${s.quizActive?'Đang mở test':'Test đóng'}</span>`:''}
      ${s.myPass ? '<span class="tag pass">Bạn đã đạt</span>':''}
    </div>
    <div class="bd">
      <h4>${esc(s.topic||'(Chưa có chủ đề)')}</h4>
      <div class="purpose">${esc(s.purpose||'—')}</div>
      <div class="s-meta">
        <span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M16 3v4M8 3v4M3 10h18"/></svg>${esc(s.dateText||'—')}</span>
        <span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>${esc(s.trainer||'—')}</span>
        <span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>${esc(s.audience||'—')}</span>
      </div>
    </div>
    <div class="ft">
      <div class="prog"><i style="width:${pct}%"></i></div>
      <span class="pct">${s.passed||0}/${s.enrolled||0} đạt</span>
    </div>
  </div>`;
}

/* ---------- DETAIL ---------- */
async function openDetail(sid){
  const s = S.sessions.find(x=>x.sid===sid);
  if(!s) return err('Không tìm thấy buổi đào tạo.');
  $('dtTitle').textContent = s.topic || '(Chưa có chủ đề)';
  $('dtSub').textContent = `${s.dateText||''} · ${s.category||''} · Trainer: ${s.trainer||''}`;
  $('ovDetail').classList.add('on');
  $('dtBody').innerHTML = '<div class="empty"><div class="spinner" style="margin:0 auto"></div></div>';
  $('dtFoot').innerHTML = '';

  let full=null, mats={data:[]}, qz=null;
  try{
    full = await apiGet('getSession',{sid:sid});
    mats = await apiGet('listMaterials',{sid:sid}).catch(()=>({data:[],folderUrl:''}));
    qz   = await apiGet('myQuizStatus',{sid:sid}).catch(()=>null);
  }catch(e){ $('dtBody').innerHTML = emptyBox('Không tải được chi tiết', e.message); return; }

  const d = full.data, enroll = full.enrollment||[];
  const pct = enroll.length ? Math.round(enroll.filter(e=>e.pass).length/enroll.length*100) : 0;

  $('dtBody').innerHTML = `
    <div class="grid g2" style="gap:20px">
      <div>
        <div class="sec-title">Thông tin buổi đào tạo</div>
        <table class="tbl" style="font-size:13.5px">
          ${infoRow('Mục tiêu', d.purpose)}
          ${infoRow('Nhóm chủ đề', `<span class="tag ${catClass(d.category)}">${esc(d.category)}</span>`,1)}
          ${infoRow('Hình thức', d.type)}
          ${infoRow('Thời gian', (d.dateText||'') + (d.timeFrom ? ' · '+d.timeFrom+(d.timeTo?'–'+d.timeTo:'') : ''))}
          ${infoRow('Trainer', d.trainer)}
          ${infoRow('Đối tượng', d.audience)}
          ${infoRow('Trạng thái', `<span class="tag ${statusClass(d.status)}">${statusText(d.status)}</span>`,1)}
          ${d.meetingLink?infoRow('Link họp', `<a href="${esc(d.meetingLink)}" target="_blank" style="color:var(--blue)">Mở link</a>`,1):''}
          ${d.recordLink?infoRow('Bản ghi', `<a href="${esc(d.recordLink)}" target="_blank" style="color:var(--blue)">Xem bản ghi</a>`,1):''}
          ${d.summary?infoRow('Tổng kết', d.summary):''}
        </table>

        <div class="sec-title" style="margin-top:22px">Tiến độ hoàn thành</div>
        <div style="display:flex;align-items:center;gap:14px;margin-bottom:12px">
          <div class="prog" style="height:9px"><i style="width:${pct}%"></i></div>
          <b style="color:var(--navy);white-space:nowrap">${enroll.filter(e=>e.pass).length}/${enroll.length} đạt</b>
        </div>
        <div class="tbl-scroll" style="max-height:230px">
          ${enroll.length?`<table class="tbl"><thead><tr><th>Học viên</th><th>Trạng thái</th><th>Điểm</th><th>Chứng chỉ</th></tr></thead><tbody>
            ${enroll.map(e=>`<tr>
              <td><b style="font-size:13px;color:var(--navy)">${esc(e.name)}</b><div style="font-size:11px;color:var(--muted)">${esc(e.email)}</div></td>
              <td><span class="tag ${e.status==='Completed'?'completed':'plan'}">${e.status==='Completed'?'Đã làm bài':'Chưa làm'}</span></td>
              <td>${e.percent!==''?`<b style="color:${e.pass?'var(--green)':'var(--red)'}">${e.percent}%</b>`:'—'}</td>
              <td>${e.certUrl?`<a href="${esc(e.certUrl)}" target="_blank" class="tag pass">Xem</a>`:'—'}</td>
            </tr>`).join('')}</tbody></table>`:emptyBox('Chưa có danh sách tham dự')}
        </div>
      </div>

      <div>
        <div class="sec-title">Tài liệu đào tạo</div>
        ${d.canEdit?`<div class="dropzone" id="dropZone" style="margin-bottom:12px">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/><path d="M17 8l-5-5-5 5M12 3v12"/></svg>
          <b style="color:var(--navy);display:block;font-size:13.5px">Kéo thả hoặc bấm để tải tài liệu lên</b>
          <span style="font-size:12px">PPT, PDF, Word, ảnh… (tối đa ~40MB/file)</span>
          <input type="file" id="fileInput" multiple style="display:none">
        </div>`:''}
        <div id="matList">${renderMaterials(mats.data||[], d.canEdit)}</div>
        ${mats.folderUrl?`<a href="${esc(mats.folderUrl)}" target="_blank" class="btn btn-ghost btn-sm btn-block" style="margin-top:10px">Mở thư mục trên Drive</a>`
          :(d.canEdit?`<button class="btn btn-ghost btn-sm btn-block" style="margin-top:10px" onclick="createFolder('${d.sid}')">Tạo thư mục tài liệu</button>`:'')}

        <div class="sec-title" style="margin-top:22px">Bài đánh giá sau đào tạo</div>
        ${renderQuizBox(d, qz)}
      </div>
    </div>`;

  const foot = [];
  if(d.canEdit){
    foot.push(`<button class="btn btn-ghost btn-sm" onclick="openSessionForm('${d.sid}')">Sửa thông tin</button>`);
    foot.push(`<button class="btn btn-ghost btn-sm" onclick="openQuizBuilder('${d.sid}')">${d.hasQuiz?'Sửa bộ câu hỏi':'Tạo bộ câu hỏi'}</button>`);
    foot.push(`<button class="btn btn-gold btn-sm" onclick="openEmail('${d.sid}')">Gửi email thông báo</button>`);
  }
  foot.push('<div style="flex:1"></div><button class="btn btn-ghost btn-sm" data-close>Đóng</button>');
  $('dtFoot').innerHTML = foot.join('');

  if(d.canEdit) bindUpload(d.sid);
}
function infoRow(k,v,raw){
  return `<tr><td style="color:var(--muted);width:34%;vertical-align:top">${esc(k)}</td><td style="color:var(--navy);font-weight:600">${raw?v:esc(v||'—')}</td></tr>`;
}
function renderMaterials(files, canEdit){
  if(!files.length) return emptyBox('Chưa có tài liệu','Tải tài liệu lên để học viên xem lại');
  return files.map(f=>`<div class="file-row">
    <div class="file-ic ${f.kind}">${f.kind==='slide'?'PPT':f.kind==='pdf'?'PDF':f.kind==='doc'?'DOC':f.kind==='sheet'?'XLS':f.kind==='image'?'IMG':f.kind==='video'?'VID':'FILE'}</div>
    <div class="nm"><b>${esc(f.name)}</b><span>${esc(f.sizeText||'')} · ${esc(f.updated||'')}</span></div>
    <button class="btn btn-ghost btn-sm" onclick="viewFile('${f.preview}','${esc(f.name).replace(/'/g,'')}','${f.url}')">Xem</button>
    ${canEdit?`<button class="icon-btn" style="background:#fdeaea;color:var(--red)" onclick="delMaterial('${f.id}','${esc(f.name).replace(/'/g,'')}')">✕</button>`:''}
  </div>`).join('');
}
function viewFile(preview,name,url){
  $('vwTitle').textContent = name;
  $('vwOpen').href = url;
  $('vwFrame').src = preview;
  $('ovViewer').classList.add('on');
}
async function delMaterial(id,name){
  if(!confirm('Xoá tài liệu "'+name+'"?')) return;
  busy(true,'Đang xoá…');
  try{ const r = await apiPost('deleteMaterial',{fileId:id}); ok(r.message); closeAll(); }
  catch(e){ err(e.message); } finally{ busy(false); }
}
async function createFolder(sid){
  busy(true,'Đang tạo thư mục…');
  try{ const r = await apiGet('createFolder',{sid:sid}); ok(r.message); await boot(); openDetail(sid); }
  catch(e){ err(e.message); } finally{ busy(false); }
}
function bindUpload(sid){
  const dz = $('dropZone'), fi = $('fileInput');
  if(!dz) return;
  dz.onclick = ()=>fi.click();
  fi.onchange = ()=>handleFiles(sid, fi.files);
  ['dragenter','dragover'].forEach(ev=>dz.addEventListener(ev,e=>{e.preventDefault();dz.classList.add('drag')}));
  ['dragleave','drop'].forEach(ev=>dz.addEventListener(ev,e=>{e.preventDefault();dz.classList.remove('drag')}));
  dz.addEventListener('drop', e=>handleFiles(sid, e.dataTransfer.files));
}
function fileToB64(f){
  return new Promise((res,rej)=>{
    const r = new FileReader();
    r.onload = ()=>res(String(r.result).split(',')[1]);
    r.onerror = ()=>rej(new Error('Không đọc được file'));
    r.readAsDataURL(f);
  });
}
async function handleFiles(sid, files){
  if(!files || !files.length) return;
  for(let i=0;i<files.length;i++){
    const f = files[i];
    if(f.size > 42*1024*1024){ err(`"${f.name}" vượt quá 40MB — hãy tải lên Drive rồi dán link.`); continue; }
    busy(true, `Đang tải "${f.name}" (${i+1}/${files.length})…`);
    try{
      const b64 = await fileToB64(f);
      const r = await apiPost('uploadMaterial',{sid:sid, filename:f.name, mime:f.type||'application/octet-stream', data:b64});
      ok(r.message);
    }catch(e){ err('Lỗi tải "'+f.name+'": '+e.message); }
  }
  busy(false);
  try{ const m = await apiGet('listMaterials',{sid:sid}); $('matList').innerHTML = renderMaterials(m.data||[], true); }catch(e){}
}

/* ---------- QUIZ BOX in detail ---------- */
function renderQuizBox(d, qz){
  if(!d.hasQuiz){
    return `<div class="card" style="box-shadow:none"><div class="card-b" style="text-align:center;padding:22px">
      <div style="font-size:13px;color:var(--muted);margin-bottom:10px">Buổi đào tạo này chưa có bộ câu hỏi đánh giá.</div>
      ${d.canEdit?`<button class="btn btn-primary btn-sm" onclick="openQuizBuilder('${d.sid}')">Tạo bộ câu hỏi</button>`:''}
    </div></div>`;
  }
  const q = qz||{};
  const done = q.best;
  return `<div class="card" style="box-shadow:none"><div class="card-b">
    <div style="display:flex;gap:10px;flex-wrap:wrap;margin-bottom:13px">
      <span class="tag gold">${d.questionCount||q.totalQuestions||0} câu hỏi</span>
      <span class="tag audience">${d.durationMin||q.durationMin||0} phút</span>
      <span class="tag audience">Đạt từ ${d.passScore||q.passScore||0}%</span>
      <span class="tag ${d.quizActive?'completed':'cancel'}">${d.quizActive?'Đang mở':'Đã đóng'}</span>
    </div>
    ${done?`<div style="background:${done.result==='Pass'?'#f0faf4':'#fdf2f2'};border-radius:11px;padding:13px 16px;margin-bottom:12px">
      <div style="font-size:12px;color:var(--muted)">Kết quả tốt nhất của bạn</div>
      <div style="font-size:24px;font-weight:850;color:${done.result==='Pass'?'var(--green)':'var(--red)'};letter-spacing:-1px">${done.percent}% <span style="font-size:13px;font-weight:600">(${done.score}/${done.maxScore})</span></div>
      <div style="font-size:12px;color:var(--muted);margin-top:2px">Nộp lúc ${esc(done.submittedAt)} · Lượt ${done.attempt}</div>
    </div>`:''}
    ${q.available
      ? `<button class="btn btn-primary btn-sm btn-block" onclick="startQuiz('${d.sid}')">${done?'Làm lại bài đánh giá':'Bắt đầu làm bài'} (lượt ${(q.attempts||0)+1}/${q.maxAttempts})</button>`
      : `<div class="hint" style="text-align:center">${esc(q.reason||'Bài đánh giá hiện không khả dụng.')}</div>`}
    ${d.canEdit?`<div style="display:flex;gap:8px;margin-top:10px">
      <button class="btn btn-ghost btn-sm" style="flex:1" onclick="openQuizBuilder('${d.sid}')">Sửa câu hỏi</button>
      <button class="btn btn-ghost btn-sm" style="flex:1" onclick="togglePublish('${d.sid}',${d.quizActive?'false':'true'})">${d.quizActive?'Đóng bài test':'Mở bài test'}</button>
    </div>`:''}
  </div></div>`;
}
async function togglePublish(sid, active){
  busy(true);
  try{ const r = await apiPost('publishQuiz',{sid:sid, active:active}); ok(r.message); await boot(); openDetail(sid); }
  catch(e){ err(e.message); } finally{ busy(false); }
}

/* ==========================================================================
   SESSION FORM
   ========================================================================== */
$('btnNewSession').onclick = ()=>openSessionForm('');
$('btnNewSession2').onclick = ()=>openSessionForm('');
function openSessionForm(sid){
  const s = sid ? S.sessions.find(x=>x.sid===sid) : null;
  S.editing = s ? s.sid : '';
  $('sesTitle').textContent = s ? 'Sửa buổi đào tạo' : 'Tạo buổi đào tạo mới';
  const meta = S.meta||{};
  const audienceOpts = [...new Set((meta.audiences||[]).concat(Object.keys({
    'MMH - All member':1,'MMH - Sales team':1,'MMH - Marketing team':1,'MMH - Back office team':1,
    'MMH - Sales Dental':1,'MMH - Sales Surgical':1,'MMH - Sales & MKT':1,'MMH - Leaders':1
  })))];
  $('sesBody').innerHTML = `
    <div class="fgroup"><label>Chủ đề đào tạo *</label>
      <input class="inp" id="f_topic" value="${esc(s?s.topic:'')}" placeholder="VD: Đặc tính & ứng dụng chỉ khâu nhãn khoa MANI"></div>
    <div class="fgroup"><label>Mục tiêu đào tạo</label>
      <textarea class="inp" id="f_purpose" placeholder="Mục tiêu học viên đạt được sau buổi đào tạo">${esc(s?s.purpose:'')}</textarea></div>
    <div class="row3">
      <div class="fgroup"><label>Ngày đào tạo *</label><input class="inp" id="f_date" type="date" value="${s?s.date:''}"></div>
      <div class="fgroup"><label>Giờ bắt đầu</label><input class="inp" id="f_from" type="time" value="${esc(s?s.timeFrom:'')}"></div>
